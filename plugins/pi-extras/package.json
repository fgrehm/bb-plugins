{
  "name": "bb-plugin-pi-extras",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.94"
  },
  "bb": {
    "name": "Pi Extras",
    "description": "Shows Pi usage, manages Pi settings and updates, flags untrusted Pi workspaces, and generates thread titles and commit messages.",
    "branding": {
      "icon": "ChartNoAxesCombined"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "scripts": {
    "test": "node --experimental-strip-types --test usage.test.ts pi-settings.test.ts pi-models.test.ts pi-title.test.ts pi-title-runner.test.ts pi-session.test.ts pi-process.test.ts pi-trust.test.ts",
    "test:components": "vitest run update-actions.test.tsx settings-panel.test.tsx title-service-settings.test.tsx pi-trust-server.test.ts trust-panel.test.tsx",
    "lint": "tsc --noEmit",
    "build": "bb plugin build"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.3",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.94",
    "@pierre/diffs": "^1.4.2",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.9.3",
    "vaul": "^1.1.2",
    "vitest": "^4.1.12"
  }
